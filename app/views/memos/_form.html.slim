= simple_form_for(@memo) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

  .form-inputs
    = f.hidden_field :info
    = f.input :content, autofocus: true, input_html: { class: 'arib-font' }
    = f.input :price
    = f.button :submit, class: 'btn btn-primary'
    = f.association :tags, as: :check_boxes, collection: memo_tag_candidates(@memo.tags, include_disabled: @memo.persisted?), label_method: ->(tag_record) { memo_tag_label(tag_record) }, wrapper: :vertical_collection_inline
    p.small = link_to t(:'.new_tag'), new_tag_path
    = f.hidden_field :lonlat

  .form-actions
    = f.button :submit, class: 'btn btn-primary'

  #debug
