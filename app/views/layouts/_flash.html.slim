- if flash[:alert]
  .alert.alert-danger role="alert"
    = flash[:alert]
- if flash[:notice]
  .alert.alert-warning.d-flex.align-items-center role="alert"
    span = flash[:notice]
    / Set by RemindersController#complete (keys are strings as the flash is stored in the session as JSON)
    - undo = flash[:undo]
    - if undo.is_a?(Hash)
      = button_to t(:'reminders.undo.button'), undo["path"], params: { completed_at: undo["completed_at"] }, class: 'btn btn-sm btn-outline-dark', form_class: 'ml-auto mb-0'
